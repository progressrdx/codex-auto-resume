<view class="page">
  <view class="brand">CODEX RELAY <text class="brand-side">手机控制台</text></view>
  <block wx:if="{{!connected}}">
    <view class="hero"><view class="title"><view>任务留在电脑，</view><view>进度随时掌握。</view></view><view class="muted">连接你自己的续航服务，与网页共享任务、额度和监控记录。</view></view>
    <view class="card">
      <label class="label" for="server">服务地址</label>
      <input id="server" class="input" value="{{base}}" bindinput="inputBase" placeholder="https://你的服务地址:8765" disabled="{{loading}}" maxlength="250"/>
      <label class="label" for="credential">连接凭据</label>
      <input id="credential" class="input" value="{{credential}}" bindinput="inputCredential" password placeholder="粘贴本机服务提供的凭据" disabled="{{loading}}" maxlength="200"/>
      <view class="hint">凭据只保存在本次运行内存中。手机上的 127.0.0.1 指向手机自身，不能连接你的电脑。</view>
      <button class="primary" id="connect-action" bindtap="connect" loading="{{loading}}" disabled="{{loading || !base || !credential}}">{{loading ? '正在连接并读取数据' : '连接本机服务'}}</button>
    </view>
    <view class="muted note">电脑需保持开机、联网，且 Codex App 与续航服务正常运行。手机关闭不影响已开启的托管。</view>
  </block>
  <block wx:else>
    <view class="connection"><text class="muted">已连接 · {{updated}} 更新</text><button size="mini" bindtap="disconnect" disabled="{{writing}}">断开</button></view>
    <view wx:if="{{pending}}" class="warning"><view class="subtitle">上一次操作结果待确认</view><view>请先刷新并核对监控记录。为避免重复操作，暂时不能再次开启或停止。</view><button bindtap="refreshAll">刷新监控记录</button><button bindtap="acknowledge" disabled="{{writing}}">已核对记录，解除待确认</button></view>
    <view wx:if="{{view === 'overview'}}">
      <view class="section"><view class="title">长任务，接着跑。</view><view class="muted">等待自然额度恢复，在原对话继续。</view></view>
      <view class="quota-grid"><view class="card metric"><view class="muted">五小时剩余额度</view><view class="number">{{primary.remaining}}<text>%</text></view><view class="hint">{{primary.reset}} 重置</view></view><view class="card metric"><view class="muted">每周剩余额度</view><view class="number">{{secondary.remaining}}<text>%</text></view><view class="hint">{{secondary.reset}} 重置</view></view></view>
      <view class="hint">{{connectionReason}}</view>
      <view class="section-row"><view class="subtitle">托管任务 · {{watches.length}}</view><button size="mini" bindtap="refreshAll">刷新</button></view>
      <view wx:if="{{!watches.length}}" class="card muted">尚无托管记录。选择一个仍在执行或因额度暂停的长任务。</view>
      <view wx:for="{{watches}}" wx:key="thread_id" class="card watch">
        <view class="task-title">{{item.title}}</view><view class="status">{{item.stateLabel}}</view><view class="muted">{{item.reason}}</view><view class="hint">已续跑 {{item.attempts}} / 累计上限 {{item.max_resumes}}</view>
        <button wx:if="{{item.enabled}}" class="danger" data-id="{{item.thread_id}}" id="stop-action" bindtap="stop" disabled="{{writing || pending}}">停止托管</button>
      </view>
      <button class="primary" id="showList-action" bindtap="showList" disabled="{{writing}}">选择一个长任务</button>
    </view>
    <view wx:elif="{{view === 'list'}}" class="picker">
      <view class="section-row"><view class="subtitle">选择长任务</view><button size="mini" bindtap="showOverview">返回概览</button></view>
      <input class="input" value="{{query}}" bindinput="query" placeholder="搜索对话标题" aria-label="搜索对话标题"/>
      <view class="section-row"><label class="muted">显示已归档 <switch checked="{{archived}}" bindchange="toggleArchived" color="#087f70"/></label><text class="hint">{{visibleCount}} 个</text></view>
      <scroll-view class="thread-list" scroll-y enhanced show-scrollbar>
        <button wx:for="{{filtered}}" wx:key="id" class="thread" data-id="{{item.id}}" bindtap="select"><view class="task-title">{{item.title}}</view><view class="hint">{{item.archived ? '已归档 · 不可托管' : '选中后识别任务状态'}}</view></button>
        <view wx:if="{{!filtered.length}}" class="muted empty">没有匹配的对话</view>
      </scroll-view>
    </view>
    <view wx:else class="detail">
      <button size="mini" id="showList-action" bindtap="showList" disabled="{{writing}}">返回对话列表</button>
      <view class="card"><view class="task-title">{{selected.title}}</view><view wx:if="{{checking}}" class="status">正在识别任务状态…</view>
        <block wx:if="{{assessment}}"><view class="status">{{assessment.stateLabel}}</view><view class="muted">{{assessment.reason}}</view><view class="hint">{{assessment.source === 'live' ? '来自 App 实时状态' : '来自本地历史；发送前会再次核验实时状态'}}</view></block>
        <button bindtap="recheck" disabled="{{checking || writing}}">重新检查</button>
      </view>
      <view wx:if="{{canStart}}" class="card">
        <label class="label" for="maximum">累计自动续跑上限</label><input id="maximum" class="input" type="number" value="{{maximum}}" bindinput="maximum" disabled="{{writing}}" maxlength="3"/>
        <checkbox-group bindchange="consent"><label class="consent"><checkbox value="yes" checked="{{consent}}" disabled="{{writing}}" color="#087f70"/><text>仅托管这个任务；必要时可打开原对话。已关闭同任务的其他自动续跑。停止托管不能撤回已发消息。</text></label></checkbox-group>
        <button class="primary" id="start-action" bindtap="start" loading="{{writing}}" disabled="{{!consent || writing || pending}}">开启托管</button>
      </view>
      <view wx:if="{{!checking && !canStart}}" class="hint">未确认适合托管时不会发送开启请求。切回小程序后请重新检查任务。</view>
    </view>
  </block>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view class="footer">只监控明确选中的任务 · 不绕过额度限制</view>
</view>
