page{background:#f5f7f8;color:#172d3c;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:16px;--muted:#506a7e;--line:#d5e1e7;--surface:#fff;--teal:#086e62;--soft:#e7f2ef}
.page{max-width:720px;margin:0 auto;padding:24px 20px calc(24px + env(safe-area-inset-bottom))}.brand{font-size:12px;letter-spacing:3px;font-weight:700;color:var(--teal)}.brand-side{float:right;letter-spacing:0;color:var(--muted);font-weight:400}.title{font-size:28px;line-height:1.4;font-weight:700;margin-bottom:12px}.hero{margin:32px 0 24px}.muted{color:var(--muted);line-height:1.65}.hint{font-size:13px;line-height:1.6;color:var(--muted);margin:12px 0;word-break:break-all}.card{padding:20px;background:var(--surface);border:1px solid var(--line);border-radius:16px;margin-bottom:16px}.label{display:block;font-size:15px;font-weight:600;margin:12px 0}.input{box-sizing:border-box;min-height:48px;height:48px;border:1px solid var(--line);border-radius:10px;padding:0 12px;background:var(--surface);color:inherit;width:100%}button{font-size:15px;min-height:48px;line-height:1.5;display:flex;align-items:center;justify-content:center;padding:12px 16px;margin:12px 0 0;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:inherit;font-weight:600}button::after{border:none}button[size=mini]{font-size:13px;min-height:44px;margin:0;padding:10px 12px}button[disabled]{opacity:.55;color:var(--muted);background:#e9eef1}.primary{background:var(--teal);border-color:var(--teal);color:white}.button-hover{opacity:.8}.connection,.section-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:20px 0}.connection .muted{font-size:12px}.section{margin:28px 0 20px}.subtitle{font-weight:700;font-size:18px}.quota-grid{display:flex;gap:12px}.metric{flex:1;min-width:0;padding:16px}.metric .muted{font-size:12px}.metric .hint{font-size:11px}.number{font-size:38px;font-weight:700;letter-spacing:-1px;margin-top:12px}.number text{font-size:16px;margin-left:4px}.task-title{font-size:16px;font-weight:650;line-height:1.6;overflow-wrap:anywhere;word-break:break-all}.status{color:var(--teal);font-weight:600;margin:12px 0}.danger{color:#a22b38}.note{font-size:14px;margin:20px 0}.footer{font-size:12px;color:var(--muted);text-align:center;margin-top:28px;line-height:1.6}.warning,.error,.notice{padding:16px;border-radius:12px;line-height:1.65;margin:16px 0}.error{background:#fff0f0;color:#a32233}.warning{background:#fff5da;color:#644508}.notice{background:var(--soft);color:var(--teal)}.consent{display:flex;align-items:flex-start;margin:20px 0;font-size:14px;line-height:1.7}.consent checkbox{flex:none;margin-right:8px;min-height:44px}.thread-list{height:55vh;min-height:180px}.thread{display:block;text-align:left;background:var(--surface);width:100%;margin:0 0 10px;padding:16px}.thread .task-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.thread .hint{margin-bottom:0}.section-row label{display:flex;align-items:center;gap:4px;font-size:13px}.empty{padding:24px;text-align:center}.detail>.card{margin-top:20px}
@media (min-width:600px){.page{padding-left:32px;padding-right:32px}.quota-grid{gap:20px}}
@media (prefers-color-scheme:dark){page{background:#14222c;color:#edf4f6;--muted:#b2c6d2;--line:#3e5564;--surface:#1c303d;--teal:#70d9c5;--soft:#213e3b}.primary{background:#087c6c;color:#fff;border-color:#087c6c}.warning{background:#493a1a;color:#ffe4a1}.error{background:#45232b;color:#ffb6c0}button[disabled]{background:#2c414f}.danger{color:#ffadb9}}
